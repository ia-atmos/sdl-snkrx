;; The win screen of level 25 with its credits: "credits" opens them, a
;; name opens its page (traced in the tests), Escape closes them, "follow
;; me on steam!" opens its page, and "loop" continues the run.
include "../../src/game.atm"
spawn Background()
spawn Camera()
spawn SlowMotion()
spawn Input()

pin run = [ level=25, loop=0, gold=10, units=[ [character="vagrant", level=3, reserve=[0, 0]] ],
            passives=[], pool=passive_pool(), shop_level=1, shop_xp=0 ]
pin A = new_arena(25)
set A.run = run
spawn Arena(A, [ [100, 100, 1] ])
val e = await :goto
print(eng.tick(), e.screen, "loop", run.loop, "ng", STATE.ng, STATE.ng_max)
