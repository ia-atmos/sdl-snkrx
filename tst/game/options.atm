;; The options in the arena: Escape opens them and stops the game, a click
;; raises the volume of the sounds, another turns dark transitions on, and
;; Escape closes them.
include "../../src/game.atm"
spawn Background()
spawn Camera()
spawn SlowMotion()
spawn Input()

pin run = [ level=1, loop=0, gold=3, units=[ ["vagrant", 1] ], passives=[], pool=[] ]
pin GA = []                     ;; the arena, lent by the block of the grabbable
spawn {
    grabbable :mouse.motion, :mouse.button.dn, :mouse.button.up, :key.dn, :key.up {
        pin A = new_arena(1)
        set A.run = run
        set :out GA.a = A
        await Arena(A)
    }
}
val A = GA.a
spawn {
    await :key.dn until it.key == "Escape"
    val t0 = A.time
    await(60, :frame)
    print("paused: game time in 1s of real time", string.format("%.3f", A.time - t0))
}
await(240, :frame)
print("sfx", VOLUME.sfx, "dark", STATE.dark_transitions)
