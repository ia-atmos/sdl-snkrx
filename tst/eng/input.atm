;; The events of the engine, from the test script: mouse, keys, time,
;; and the game time in slow motion.

pin var STATE = [ volume = [ sfx=0.5, music=0.5 ] ]    ;; the game's, which the engine reads
include "../../eng/eng.atm"

spawn {
    loop e on :mouse {
        val mx, my = eng.mouse()
        print(eng.tick(), e.tag, mx, my, e.button)
    }
}
spawn {
    loop e on :key {
        print(eng.tick(), e.tag, e.key)
    }
}
spawn {
    await 1s
    print(eng.tick(), "1s")
    await 500ms
    print(eng.tick(), "1.5s")
    eng.slow(0.5)
    await 1s
    print(eng.tick(), "1s at half speed")
    eng.slow(1)
}
spawn {
    val e = await :frame
    print(eng.tick(), e.tag, e.us)
}
await(false)
