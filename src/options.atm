;; The options, with the game paused (`open_options` and `close_options`
;; of `main.lua:1844-2105`): a modal with buttons, opened and closed with
;; Escape: the volumes of the sounds and of the music, mouse control,
;; dark transitions, the run timer, the size of the window, screen shake,
;; the cooldowns and the arrow drawn on the snake, screen movement, the
;; new game plus (in the menu), a restart of the run, the menu, and quit.
;; The window starts at the size of the desktop, as the original, or at
;; the size saved.

;; The text of an option.
func onoff (b) {
    if b => "yes" => "no"
}

;; A volume one step up (from 1 back to 0), or down (from 0 to 1).
func volume_step (v, down) {
    val n = math.floor(v*10 + 0.5) + (if down => -1 => 1)
    ifs {
        n > 10 => 0
        n < 0 => 1
        else => n/10
    }
}

;; The game time follows `st.v` while the options are open.
task PauseTime (st) {
    loop on :frame {
        eng.slow(st.v)
    }
}

;; The new game plus in play, in the menu.
task NgText () {
    loop on :draw {
        text_draw(shop_text("[bg10]current: " ++ tostring(STATE.ng)), W/2 + 63, H - 50)
    }
}

;; Options from the menu (`kind` :menu), the shop (:shop), or the arena
;; (:arena). It ends on resume; restart, the menu, and quit go to their
;; screens (`:goto`).
task Options (kind, host) {
    set pub = [ springs=[] ]                ;; the springs its buttons lend
    val springs = pub.springs
    eng.cursor(true)
    pin ps = tasks()
    spawn @ps Modal()
    ;; the game stops in 0.25s, and comes back in 0.25s
    pin st = [ v=1 ]
    spawn @ps PauseTime(st)
    spawn @ps TweenReal(0.25, st, [v=0], linear)
    if kind == :arena {
        spawn @ps Text2(W/2, H/2 - 108, text([ [text="[bg10]<-, a or m1       ->, d or m2", font=fat_font, alignment=:center] ]), 0.6, 0.6)
        spawn @ps Text2(W/2, H/2 - 92, text([ [text="[bg10]turn left                                            turn right", font=pixul_font, alignment=:center] ]))
    }
    val me = task
    pin label = func (id) {
        match id {
            :resume => if kind == :menu => "main menu (esc)" => "resume game (esc)"
            :restart => "restart run (r)"
            :sfx => "sfx volume: " ++ tostring(math.floor(VOLUME.sfx*10 + 0.5))
            :music => "music volume: " ++ tostring(math.floor(VOLUME.music*10 + 0.5))
            :dark => "dark transitions: " ++ onoff(STATE.dark_transitions)
            :shake => "screen shake: " ++ onoff(STATE.screen_shake != false)
            :mouse => "mouse control: " ++ onoff(STATE.mouse_control)
            :timer => "run timer: " ++ onoff(STATE.run_timer)
            :size_down => "window size-"
            :size_up => "window size+"
            :fullscreen => "fullscreen"
            :reset_video => "reset video settings"
            :cooldowns => "cooldowns on snake: " ++ onoff(STATE.cooldown_snake)
            :arrow => "arrow on snake: " ++ onoff(STATE.arrow_snake)
            :movement => "screen movement: " ++ onoff(STATE.screen_movement)
            :ng_down => "NG+ down"
            :ng_up => "NG+ up"
            :menu => "main menu"
            else => "quit"
        }
    }
    pin places = [
        [:resume, W/2, H - 225], [:sfx, W/2 - 46, H - 175], [:music, W/2 + 48, H - 175],
        [:mouse, W/2 - 113, H - 150], [:dark, W/2 + 13, H - 150], [:timer, W/2 + 121, H - 150],
        [:size_down, W/2 - 136, H - 125], [:size_up, W/2 - 50, H - 125],
        [:fullscreen, W/2 + 29, H - 125], [:reset_video, W/2 + 129, H - 125],
        [:shake, W/2 - 57, H - 100, 110], [:cooldowns, W/2 + 75, H - 100, 145],
        [:movement, W/2 - 69, H - 75, 135], [:arrow, W/2 + 65, H - 75, 125],
        [:quit, W/2, H - 25],
    ]
    if kind == :menu {
        set places@+ = [:ng_down, W/2 - 58, H - 50]
        set places@+ = [:ng_up, W/2 + 5, H - 50]
        spawn @ps NgText()
    } else {
        set places@+ = [:restart, W/2, H - 200]
        set places@+ = [:menu, W/2, H - 50]
    }
    ;; the buttons are made again when their texts change
    spawn {
        loop {
            do {
                pin bs = tasks()
                loop _, p in places {
                    spawn @bs Button(me, p@0, p@1, p@2, label(p@0), p@3 && [ w=p@3 ])
                }
                await :Options.changed
            }
        }
    }
    loop {
        val e = await <:Button.click || :key.dn>
        val id = if e ?? :key.dn => (match e.key { "Escape" => :resume ; "R" => (if kind == :menu => nil => :restart) ; else => nil }) => e.id
        if id {
            option_sound(id, springs@(e.id))
        }
        until id == :resume
        match id {
            :sfx => {
                set VOLUME.sfx = volume_step(VOLUME.sfx, e.but == 3)
            }
            :music => {
                set VOLUME.music = volume_step(VOLUME.music, e.but == 3)
            }
            :dark => set STATE.dark_transitions = !STATE.dark_transitions
            :shake => set STATE.screen_shake = !(STATE.screen_shake != false)
            :mouse => set STATE.mouse_control = !STATE.mouse_control
            :timer => set STATE.run_timer = !STATE.run_timer
            :cooldowns => set STATE.cooldown_snake = !STATE.cooldown_snake
            :arrow => set STATE.arrow_snake = !STATE.arrow_snake
            :movement => {
                set STATE.screen_movement = !STATE.screen_movement
                if !STATE.screen_movement {
                    set CAM.x = W/2
                    set CAM.y = H/2
                    set CAM.r = 0
                }
            }
            :size_down => window_step(-0.5)
            :size_up => window_step(0.5)
            :fullscreen => set STATE.sx = eng.window(0)
            :reset_video => set STATE.sx = eng.window(0)
            :ng_down => set STATE.ng = math.max(0, math.min(STATE.ng - 1, 5))
            :ng_up => set STATE.ng = math.max(0, math.min(STATE.ng + 1, STATE.ng_max))
            :restart => {
                save("state.atm", STATE)
                emit @:global :goto [ screen=:restart, x=W/2, y=H/2, color=fg@0, text="[wavy, bg]restarting..." ]
                await(false)
            }
            :menu => {
                save("state.atm", STATE)
                emit @:global :goto [ screen=:menu, x=W/2, y=H/2, color=fg@0, text="[wavy, bg].." ]
                await(false)
            }
            :quit => {
                save("state.atm", STATE)
                emit @:global :goto [ screen=:quit ]
                await(false)
            }
        }
        save("state.atm", STATE)
        emit @me :Options.changed
    }
    ;; the input comes back at once, before the game time does
    if host {
        emit @host :Options.closing
    }
    await TweenReal(0.25, st, [v=1], linear)
    eng.cursor((kind != :arena) || STATE.mouse_control)
}

;; Escape opens the options, and Escape (or resume) closes them. While
;; they are closed, the time of the run goes on (`run_time`).
task Pause (kind, run) {
    loop {
        await PauseKey(run)
        await Options(kind)
    }
}

;; Escape (or `:Pause.open`) asks for the options; until then, the time of
;; the run passes.
task PauseKey (run) {
    par :any {
        await :key.dn until it.key == "Escape"
    } with {
        await :Pause.open
    } with {
        await RunClock(run)
    }
    play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
}

;; In the shop, the shop itself opens the options (`:Shop.options`), so
;; that it is muted behind them: the original does not update the
;; shop while it is `paused`, so a click behind the options buys nothing.
task ShopPause (run, shop) {
    loop {
        await PauseKey(run)
        emit @shop :Shop.options
        await :Shop.resumed
    }
}

;; The time of the run, in real time, as `run_time = run_time + dt` in
;; the shop and in the arena (not while paused, nor after the death or
;; the win).
task RunClock (run) {
    if run {
        loop e on :frame {
            set run.time = (run.time || 0) + e.us/1000000
        }
    }
    await(false)
}

;; The sounds of a click on an option, as the actions of the buttons of
;; `open_options` (`main.lua:1859-2104`): restart and the menu sound the
;; transition and pull the button; the volumes pull it; the other options
;; only switch, and "window size-" only when the window can shrink; resume,
;; "reset video settings", and quit are silent.
func option_sound (id, spring) {
    val pull = func () {
        play(ui_switch2, [pitch=rfloat(0.95, 1.05), volume=0.5])
        if spring {
            spring_pull(spring, 0.2, 200, 10)
        }
        play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    }
    ifs {
        (id == :restart) || (id == :menu) => {
            play(ui_transition2, [pitch=rfloat(0.95, 1.05), volume=0.5])
            pull()
        }
        (id == :sfx) || (id == :music) => pull()
        (id == :resume) || (id == :reset_video) || (id == :quit) => nil
        (id == :size_down) => {
            if (STATE.sx || 2) > 1 {
                play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
            }
        }
        else => play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    }
}

;; The size of the window, half a step smaller or larger (the buttons
;; "window size-" and "+", and the keys K and L): not below 1.
func window_step (d) {
    val s = (STATE.sx || 2) + d
    if s >= 1 {
        set STATE.sx = eng.window(s)
    }
}

;; The keys K and L, anywhere, as the update of `main.lua`.
task WindowKeys () {
    loop e on :key.dn {
        match e.key {
            "K" => if (STATE.sx || 2) > 1 { window_step(-0.5) ; save("state.atm", STATE) }
            "L" => { window_step(0.5) ; save("state.atm", STATE) }
        }
    }
}
