;; The keys of the original that are held, rather than pressed: turning
;; left and right (`input:bind('move_left', {'a', 'left', 'm1'})` and
;; `('move_right', {'d', 'e', 's', 'right', 'm2'})`). A count per action,
;; of the keys and buttons held for it.

pin HELD = [ left=0, right=0 ]

;; When an action started to be held, in seconds of real time, as
;; `move_left_pressed` (not while the other one is held), or nil.
pin HELD_SINCE = [ left=nil, right=nil ]

func held_press (a) {
    set HELD@(a) += 1
    val other = if a == :left => :right => :left
    if (HELD@(a) == 1) && !HELD_SINCE@(other) {
        set HELD_SINCE@(a) = eng.tick() / 60
    }
}

func held_release (a) {
    set HELD@(a) = math.max(0, HELD@(a) - 1)
    if HELD@(a) == 0 {
        set HELD_SINCE@(a) = nil
    }
}

;; With mouse control, whether the leader turned to one side (`dir`, -1
;; left or 1 right) in all of the last 64 ticks, by at least half
;; (`table.all(mouse_control_v_buffer, ...)`: true while it is empty).
func mouse_turning (A, dir) {
    if !STATE.mouse_control {
        return false
    }
    loop _, v in A.mouse_v || [] {
        if (v*dir) < 0.5 {
            return false
        }
    }
    true
}

;; Whether an action is held for more than `s` seconds.
func held_for (a, s) {
    HELD_SINCE@(a) && ((eng.tick()/60 - HELD_SINCE@(a)) > s)
}

pin KEY_ACTION = [ A=:left, Left=:left, D=:right, E=:right, S=:right, Right=:right ]
pin BUT_ACTION = [ @1=:left, @3=:right ]

task Input () {
    par {
        loop e on :key.dn {
            val a = KEY_ACTION@(e.key)
            if a { held_press(a) }
        }
    } with {
        loop e on :key.up {
            val a = KEY_ACTION@(e.key)
            if a { held_release(a) }
        }
    } with {
        loop e on :mouse.button.dn {
            val a = BUT_ACTION@(e.button)
            if a { held_press(a) }
        }
    } with {
        loop e on :mouse.button.up {
            val a = BUT_ACTION@(e.button)
            if a { held_release(a) }
        }
    }
}
