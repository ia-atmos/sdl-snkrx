;; The keys of the original that are held, rather than pressed: turning
;; left and right (`input:bind('move_left', {'a', 'left', 'm1'})` and
;; `('move_right', {'d', 'e', 's', 'right', 'm2'})`). Per action: `n`, the
;; count of the keys and buttons held for it, and `since`, when it started
;; to be held, in seconds of real time, as `move_left_pressed` (not while
;; the other one is held), or nil.
pin HELD = [ left=[n=0, since=nil], right=[n=0, since=nil] ]

func held_press (a) {
    val h = HELD@a
    set h.n += 1
    val other = if a == :left => :right => :left
    if (h.n == 1) && !HELD@other.since {
        set h.since = eng.tick() / 60
    }
}

func held_release (a) {
    val h = HELD@a
    set h.n = math.max(0, h.n - 1)
    if h.n == 0 {
        set h.since = nil
    }
}

;; With mouse control, whether the leader turned to one side (`dir`, -1
;; left or 1 right) in all of the last 64 ticks, by at least half
;; (`table.all(mouse_control_v_buffer, ...)`: true while it is empty).
func mouse_turning (A, dir) {
    if !STATE.mouse_control {
        return false
    }
    loop _, v in A.mouse_v || [] {
        if (v*dir) < 0.5 {
            return false
        }
    }
    true
}

;; Whether an action is held for more than `s` seconds.
func held_for (a, s) {
    val since = HELD@a.since
    since && ((eng.tick()/60 - since) > s)
}

pin KEY_ACTION = [ A=:left, Left=:left, D=:right, E=:right, S=:right, Right=:right ]
pin BUT_ACTION = [ left=:left, right=:right ]

task Input () {
    par {
        loop e on :key.dn {
            val a = KEY_ACTION@(e.key)
            if a { held_press(a) }
        }
    } with {
        loop e on :key.up {
            val a = KEY_ACTION@(e.key)
            if a { held_release(a) }
        }
    } with {
        loop e on :mouse.button.dn {
            val a = BUT_ACTION@(e.button)
            if a { held_press(a) }
        }
    } with {
        loop e on :mouse.button.up {
            val a = BUT_ACTION@(e.button)
            if a { held_release(a) }
        }
    }
}
