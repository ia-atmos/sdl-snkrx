;; The save of the state and of the run, as `system.save_state` and
;; `system.save_run` of the original, as data of Atmos (`X.dump`, read
;; back by `X.load`) in the directory `SNX_SAVE` (by default
;; `~/.local/share/sdl-snkrx`; in the test mode, only if `SNX_SAVE` is
;; given): `state.atm` is `STATE` as it is, `run.atm` the run without its
;; live objects. An empty `run.atm` means no run to continue.

val SAVE_DIR = os.getenv("SNX_SAVE") ||
    (if os.getenv("SDL_ATM_FRAMES") => nil => ((os.getenv("HOME") || ".") ++ "/.local/share/sdl-snkrx"))

;; Writes `v` as data in the file `name` (nothing for nil).
func save (name, v) {
    if SAVE_DIR {
        eng.write_file(SAVE_DIR ++ "/" ++ name, if v == nil => "" => X.dump(v))
    }
}

;; The value written in the file `name`, or nil.
func load (name) {
    val s = SAVE_DIR && eng.read_file(SAVE_DIR ++ "/" ++ name)
    if s && (#s > 0) => X.load(s) => nil
}

;; An achievement, as `state.achievement_x = true; system.save_state()`
;; with `steam.userStats.setAchievement`: once, saved with the state.
func achieve (name) {
    if !STATE.achievements@(name) {
        set STATE.achievements@(name) = true
        trace("achievement", name)
        save("state.atm", STATE)
    }
}

func state_load () {
    loop k, v in load("state.atm") || [] {
        set STATE@(k) = v
    }
    ;; as `engine_run`: the size saved, or else the size of the desktop
    ;; (not in the test mode, whose screenshots are at 2 pixels per pixel)
    ifs {
        STATE.sx => eng.window(STATE.sx)
        !eng.testing() => set STATE.sx = eng.window(0)
    }
    set VOLUME.sfx = STATE.sfx_volume
    set VOLUME.music = STATE.music_volume
}

func run_save (run) {
    save("run.atm", [
        level = run.level, loop = run.loop, gold = run.gold, time = run.time || 0,
        shop_level = run.shop_level, shop_xp = run.shop_xp,
        locked = run.locked && run.cards && true, cards = run.locked && run.cards,
        units = iter.map(run.units, \(u) {
            [ character=unit_character(u), level=unit_level(u),
              reserve=[u.reserve && u.reserve@0 || 0, u.reserve && u.reserve@1 || 0] ]
        }),
        passives = iter.map(run.passives, \(p) { [ passive=p.passive, level=p.level, xp=p.xp ] }),
        pool = run.pool || [],
    ])
}
