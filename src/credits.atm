;; The credits (`Arena:create_credits`, `arena.lua:887-958`), over the
;; screen of the win, and the buttons of that screen that open pages on
;; the web (`open_url` and `SteamFollowButton`). A page opens with
;; `open_url` (`eng/eng.atm`).

;; The click on a button that opens a page, as `open_url(b, url)`.
func url_click (s, url) {
    play(ui_switch2, [pitch=rfloat(0.95, 1.05), volume=0.5])
    spring_pull(s, 0.2, 200, 10)
    play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    open_url(url)
}

