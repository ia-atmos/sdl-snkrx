;; The colors of a button by its name: [text, background].
func button_colors (c) {
    match c {
        :blue => [ "bluem5", blue ]
        :green => [ "greenm5", green ]
        :yellow => [ "yellowm5", yellow ]
        :red => [ "redm5", red ]
        else => [ "bg10", bg ]
    }
}

;; The credits: a dark screen with the names, each a button to its page.
;; They end with "x" or Escape.
task Credits () {
    set pub = [ springs=[] ]                ;; the springs its buttons lend
    val springs = pub.springs
    spawn {
        loop on :draw {
            eng.rect(W/2, H/2, 2*W, 2*H, nil, nil, rgba(0.1, 0.1, 0.1, 0.9))
        }
    }
    pin ps = tasks()
    pin urls = []
    loop i, c in CREDITS {
        if c@4 {
            pin cs = button_colors(c@3)
            set urls@i = c@4
            spawn @ps Button(task, i, c@0, c@1, c@2, [ fg_color=cs@0, bg_color=cs@1 ])
        } else {
            spawn @ps Text2(c@0, c@1, text([ [text=c@2, font=pixul_font] ]))
        }
    }
    spawn @ps Button(task, :close, W - 20, 20, "x")
    par :any {
        loop e on :Button.click {
            until e.id == :close
            url_click(springs@(e.id), urls@(e.id))
        }
    } with {
        await :key.dn until it.key == "Escape"
    }
}

;; The buttons of the win (`Arena:quit`): "loop", "restart" (or not, after
;; the last new game plus), "credits", and the pages; the choice of loop or
;; restart is emitted to the program (`:Won.pick [id]`, which `Won`
;; awaits: these buttons outlive it, in the pool of the arena, and cannot
;; hold it). While the credits are open,
;; the buttons below stop (`in_credits`), as the shop under its tutorial.
task WinButtons (last) {
    set pub = [ springs=[] ]                ;; the springs its buttons lend
    val springs = pub.springs
    par {
        mute <!:draw> on :Win.mute {
            pin bs = tasks()
            val me = task
            pin follow = [ fg_color="greenm5", bg_color=green, w=text_width(pixul_font, "follow me on steam!") + 12, pull=0.05, dy=0 ]
            if last {
                spawn @bs Button(me, :follow, W/2 + 40, H/2 + 58, "follow me on steam!", follow)
                spawn @bs Button(me, :credits, W - 40, H - 44, "credits")
                spawn @bs Button(me, :loop, W - 39, H - 20, "  loop  ")
                spawn @bs Button(me, :nimble, W/2 - 50 + 40, H/2 + 12, "nimble quest", [ fg_color="bluem5", bg_color=blue ])
                spawn @bs Button(me, :underlords, W/2 + 50 + 40, H/2 + 12, "dota underlords", [ fg_color="bluem5", bg_color=blue ])
            } else {
                spawn @bs Button(me, :follow, W/2 + 40, H/2 - 10, "follow me on steam!", follow)
                spawn @bs Button(me, :soundtrack, W/2 + 40, H/2 + 33, "buy the soundtrack!", [ fg_color="greenm5", bg_color=green ])
                spawn @bs Button(me, :loop, W - 40, H - 44, "  loop  ")
                spawn @bs Button(me, :restart, W - 40, H - 20, "restart")
                spawn @bs Button(me, :credits, W - 40, H - 68, "credits")
            }
            loop e on :Button.click {
                match e.id {
                    :follow => url_click(springs@(e.id), "https://store.steampowered.com/dev/a327ex/")
                    :soundtrack => url_click(springs@(e.id), "https://kubbimusic.com/album/ember")
                    :nimble => url_click(springs@(e.id), "https://store.steampowered.com/app/259780/Nimble_Quest/")
                    :underlords => url_click(springs@(e.id), "https://store.steampowered.com/app/1046930/Dota_Underlords/")
                    :credits => emit @me :Credits.open
                    else => emit @:global :Won.pick [ id=e.id ]
                }
            }
        }
    } with {
        loop {
            await :Credits.open
            emit @:task :Win.mute [true]
            await Credits()
            emit @:task :Win.mute [false]
        }
    }
}
